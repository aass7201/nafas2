[Unit]
Description=Nafas2 Telegram Bot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/nafas2
ExecStart=/home/ubuntu/nafas2/venv/bin/python bot.py
Restart=always
RestartSec=10
EnvironmentFile=/home/ubuntu/nafas2/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target